# Python virtualenv & cache
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environment variables
.env
.env.local

# GCP service account keys -- never commit these (this repo is public)
*.json
*:Zone.Identifier
credentials/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Claude Code local tool settings (no secrets, just permission config)
.claude/

# Project logs & outputs
*.log
output/
artifacts/

# SQLite database files (and any suffixed backup, e.g. powerscaler.db.bak-preclean --
# a bare *.bak would not match those, since they don't end in .bak)
*.db
*.db.*
*.db-shm
*.db-wal
*.sqlite3
*.bak
*.bak-*

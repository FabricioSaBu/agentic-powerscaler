# Agentic PowerScaler Configuration

# Google Cloud / Vertex AI (required for the hackathon-compliant path). Setting
# GOOGLE_CLOUD_PROJECT switches Gemini calls to Vertex AI, authenticated via Application
# Default Credentials (gcloud auth application-default login, or the Cloud Run service
# account in production) -- no API key needed.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# "global" (not a region) is required for current-generation Gemini 3.x models -- a
# regional endpoint like us-central1 404s even though the model exists.
GOOGLE_CLOUD_LOCATION=global

# Google Gemini AI Settings. GEMINI_API_KEY is an AI Studio fallback for local/offline dev
# when GOOGLE_CLOUD_PROJECT isn't set -- leave both unset to run fully offline/simulated.
GEMINI_API_KEY=****
GEMINI_MODEL=gemini-2.5-flash

# Parallel API Settings (https://platform.parallel.ai/) -- required for the Parallel track.
PARALLEL_API_KEY=****

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: Model Context Protocol (MCP) Server Endpoint
# MCP_SERVER_URL=http://localhost:8080/mcp

# Database (SQLite via async SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///./powerscaler.db

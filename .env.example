# Agentic PowerScaler Configuration

# Google Gemini API Settings (https://aistudio.google.com/)
GEMINI_API_KEY=****
GEMINI_MODEL=gemini-3.5-flash-lite

# Parallel API Settings (https://platform.parallel.ai/)
PARALLEL_API_KEY=****

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: Model Context Protocol (MCP) Server Endpoint
# MCP_SERVER_URL=http://localhost:8080/mcp

# Database (SQLite via async SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///./powerscaler.db

# LangSmith Observability (https://smith.langchain.com/) -- optional.
# Leave LANGSMITH_API_KEY unset to disable tracing entirely (zero overhead).
LANGSMITH_API_KEY=****
LANGSMITH_PROJECT=agentic-powerscaler
